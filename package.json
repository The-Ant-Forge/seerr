{
  "name": "seerr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "next telemetry disable",
    "dev": "nodemon -e ts --watch server --watch seerr-api.yml -e .json,.ts,.yml -x ts-node -r tsconfig-paths/register --files --project server/tsconfig.json server/index.ts",
    "build:server": "tsc --project server/tsconfig.json && copyfiles -u 2 server/templates/**/*.{html,pug} dist/templates && tsc-alias -p server/tsconfig.json",
    "build:next": "next build --webpack",
    "build": "pnpm build:next && pnpm build:server",
    "lint": "eslint \"./server/**/*.{ts,tsx}\" \"./src/**/*.{ts,tsx}\" --cache",
    "lintfix": "eslint \"./server/**/*.{ts,tsx}\" \"./src/**/*.{ts,tsx}\" --fix",
    "start": "NODE_ENV=production node dist/index.js",
    "i18n:extract": "ts-node --project server/tsconfig.json src/i18n/extractMessages.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:generate -d server/datasource.ts",
    "migration:create": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:create -d server/datasource.ts",
    "migration:run": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:run -d server/datasource.ts",
    "format": "prettier --log-level warn --write --cache .",
    "format:check": "prettier --check --cache .",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:client",
    "typecheck:server": "tsc --project server/tsconfig.json --noEmit",
    "typecheck:client": "tsc --noEmit",
    "prepare": "node bin/prepare.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:prepare": "ts-node -r tsconfig-paths/register --files --project server/tsconfig.json server/scripts/prepareTestDb.ts",
    "e2e:build": "pnpm build && pnpm e2e:prepare"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seerr-team/seerr.git"
  },
  "license": "MIT",
  "dependencies": {
    "@dr.pogodin/csurf": "^1.16.9",
    "@floating-ui/react": "^0.27.19",
    "@fontsource-variable/inter": "^5.2.8",
    "@formatjs/intl-displaynames": "7.3.10",
    "@formatjs/intl-locale": "5.3.9",
    "@formatjs/intl-pluralrules": "6.3.10",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@seerr-team/react-tailwindcss-datepicker": "^1.3.4",
    "@svgr/webpack": "8.1.0",
    "adm-zip": "^0.5.17",
    "axios": "1.18.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "^12.11.1",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.7",
    "country-flag-icons": "1.6.18",
    "cronstrue": "3.20.0",
    "dns-caching": "^0.2.9",
    "email-templates": "13.0.1",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "express-rate-limit": "8.5.2",
    "express-session": "1.19.0",
    "formik": "^2.4.9",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "lodash": "4.18.1",
    "next": "^16.2.9",
    "node-cache": "5.1.2",
    "node-schedule": "2.1.1",
    "nodemailer": "8.0.7",
    "openpgp": "6.3.1",
    "pg": "8.22.0",
    "pug": "3.0.4",
    "react": "^19.2.7",
    "react-aria": "3.50.0",
    "react-dom": "^19.2.7",
    "react-intl": "^10.1.7",
    "react-markdown": "10.1.0",
    "react-select": "5.10.2",
    "react-transition-group": "^4.4.5",
    "reflect-metadata": "0.2.2",
    "rehype-sanitize": "^6.0.0",
    "sharp": "^0.34.5",
    "swagger-ui-express": "5.0.1",
    "swr": "2.4.1",
    "tailwind-merge": "^3.6.0",
    "typeorm": "0.3.29",
    "ua-parser-js": "^2.0.9",
    "undici": "^8.5.0",
    "use-sync-external-store": "^1.6.0",
    "validator": "^13.15.35",
    "web-push": "3.6.7",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "xml2js": "0.6.2",
    "yaml": "^2.9.0",
    "yup": "1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/country-flag-icons": "1.2.2",
    "@types/email-templates": "10.0.4",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/lodash": "4.17.24",
    "@types/node": "25.8.0",
    "@types/node-schedule": "2.1.8",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/secure-random-password": "0.2.3",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ua-parser-js": "^0.7.39",
    "@types/validator": "^13.15.10",
    "@types/web-push": "3.6.4",
    "@types/xml2js": "0.4.14",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "autoprefixer": "^10.5.0",
    "commitizen": "4.3.2",
    "copyfiles": "2.4.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-formatjs": "6.4.15",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "node-gyp": "^12.3.0",
    "nodemon": "3.1.14",
    "postcss": "^8.5.15",
    "prettier": "3.8.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.3",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.17",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^10.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --no-warn-ignored --max-warnings=-1"
    ],
    "**/*.js": [
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "sharp",
      "better-sqlite3"
    ],
    "overrides": {
      "@types/express-session": "1.18.2"
    }
  }
}
